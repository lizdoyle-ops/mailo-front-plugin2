# ── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Front API credentials ────────────────────────────────────────────────────
# Get your API token at: Front → Settings → Developers → API tokens
FRONT_API_TOKEN=your_api_token_here

# ── Target inbox ID (optional fallback) ─────────────────────────────────────
# Format: inb_XXXXXXXX
FRONT_INBOX_ID=

# ── BYOA Agent → Front OAuth (client credentials) ───────────────────────────
# From Front Settings → AI Teammates → your agent → Agent → Front section
FRONT_OAUTH_URL=https://your-workspace.frontapp.com/oauth/token
FRONT_CLIENT_ID=your_client_id
FRONT_CLIENT_SECRET=your_client_secret

# ── BYOA Webhook signing secret ──────────────────────────────────────────────
# From Front Settings → AI Teammates → your agent → Front → Agent section
FRONT_WEBHOOK_SECRET=
